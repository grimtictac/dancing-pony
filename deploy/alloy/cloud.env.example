# /etc/alloy/cloud.env on the droplet: root:alloy, mode 0640. Values come
# from the Grafana Cloud portal (your stack → Details on Prometheus and on
# Loki). Never commit the real file.

# Prometheus: "Remote Write Endpoint" and "Username / Instance ID".
GRAFANA_PROM_URL=https://prometheus-prod-XX-prod-eu-west-X.grafana.net/api/prom/push
GRAFANA_PROM_USER=1234567

# Loki: "URL" with /loki/api/v1/push added, and its "User".
GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=1234567

# An access policy token with only metrics:write and logs:write.
GRAFANA_TOKEN=glc_...
