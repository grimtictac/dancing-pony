{
  "uid": "pony-api",
  "title": "Pony API",
  "tags": ["pony"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "API up",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job=\"pony\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "id": 2, "type": "stat", "title": "Requests / s",
      "gridPos": { "x": 4, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(pony_http_requests_total[1m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "id": 3, "type": "stat", "title": "Server error ratio (5m)",
      "gridPos": { "x": 9, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(pony_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(pony_http_requests_total[5m]))" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.05, "color": "red" }] }
        }
      }
    },
    {
      "id": 4, "type": "stat", "title": "Reviews written (1h)",
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(pony_reviews_written_total[1h]))" }],
      "fieldConfig": { "defaults": { "decimals": 0, "noValue": "0" } }
    },
    {
      "id": 5, "type": "stat", "title": "Goroutines",
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "go_goroutines{job=\"pony\"}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Requests / s by route",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (route) (rate(pony_http_requests_total[1m]))", "legendFormat": "{{route}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "p95 latency by route",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(pony_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Error responses / s by status",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(pony_http_requests_total{status=~\"[45]..\"}[1m]))", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Reviews written by sentiment",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (sentiment) (increase(pony_reviews_written_total[5m]))", "legendFormat": "{{sentiment}}" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Heap in use",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "go_memstats_heap_inuse_bytes{job=\"pony\"}", "legendFormat": "heap" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "CPU seconds / s",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"pony\"}[1m])", "legendFormat": "cpu" }]
    }
  ]
}
