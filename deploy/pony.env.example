# /etc/pony/pony.env on the droplet: root:pony, mode 0640. Fill in the
# passwords from the DigitalOcean database panel; never commit this file.
# Quote values: pony-deploy also reads this file with bash, and URLs contain "&".
# DigitalOcean's CA certificate goes in /etc/pony/do-ca.crt, so the
# database's identity is verified (sslmode=verify-full), not just encrypted.

# The API, as pony_app (subject to Row-Level Security).
PONY_DATABASE_URL="postgres://pony_app:PASSWORD@HOST:25060/dancingpony?sslmode=verify-full&sslrootcert=/etc/pony/do-ca.crt"

# Migrations and seeding, as the schema owner (doadmin).
PONY_MIGRATE_DATABASE_URL="postgres://doadmin:PASSWORD@HOST:25060/dancingpony?sslmode=verify-full&sslrootcert=/etc/pony/do-ca.crt"

# Nginx on the same box is the only proxy whose forwarding headers count.
PONY_TRUSTED_PROXIES=127.0.0.1/32
PONY_LOG_LEVEL=info
GOMEMLIMIT=300MiB
