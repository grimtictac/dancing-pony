# Copy to .env (git-ignored) and adjust. Read by docker-compose.yml.
# Local development only; Postgres is published on 127.0.0.1.
POSTGRES_USER=dancingponysvc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dancingpony
# Password for pony_app, the role the API connects as. Only applied when
# the Postgres data volume is first created.
PONY_APP_DB_PASSWORD=change-me-too
# Grafana's "admin" user. Dashboards are viewable without logging in.
GRAFANA_ADMIN_PASSWORD=change-me-three

# Host ports, all on 127.0.0.1. Uncomment to change.
# PONY_PORT=8080
# POSTGRES_PORT=5432
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# PONY_INTERNAL_PORT=9091

# Read by pony when run on the host (make migrate, make seed, make run); the
# Makefile loads this file. Keep users, passwords and the port in step with
# the values above, and URL-encode any special characters in passwords.
PONY_MIGRATE_DATABASE_URL=postgres://dancingponysvc:change-me@127.0.0.1:5432/dancingpony?sslmode=disable
PONY_DATABASE_URL=postgres://pony_app:change-me-too@127.0.0.1:5432/dancingpony?sslmode=disable
