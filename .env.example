# Copy to .env (git-ignored) and adjust. Read by docker-compose.yml.
# Local development only; Postgres is published on 127.0.0.1.
POSTGRES_USER=dancingponysvc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dancingpony

# Host ports, all on 127.0.0.1. Uncomment to change.
# PONY_PORT=8080
# POSTGRES_PORT=5432
# PROMETHEUS_PORT=9090

# Read by pony when run on the host (make migrate, make run); the Makefile
# loads this file. Keep the user and password in step with the values above,
# and URL-encode any special characters in the password.
PONY_MIGRATE_DATABASE_URL=postgres://dancingponysvc:change-me@127.0.0.1:5432/dancingpony?sslmode=disable
