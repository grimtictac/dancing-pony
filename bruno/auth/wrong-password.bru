meta {
  name: Wrong password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "frodo@shire.example",
    "password": "not the password at all"
  }
}

docs {
  Same 401 and message for a wrong password and an unknown email, so the
  response doesn't reveal which accounts exist.
}

assert {
  res.status: eq 401
  res.body.detail: eq "invalid email or password"
}
