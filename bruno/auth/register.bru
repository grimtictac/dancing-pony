meta {
  name: Register
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Peregrin Took",
    "email": "{{newEmail}}",
    "password": "a long enough password"
  }
}

script:pre-request {
  bru.setVar("newEmail", `pippin-${Date.now()}@shire.example`);
}

docs {
  Name: 1 to 100 characters. Passwords: 12 to 128 characters, no composition rules. An email that is
  already registered gets 409.
}

assert {
  res.status: eq 201
  res.body.name: eq "Peregrin Took"
}
