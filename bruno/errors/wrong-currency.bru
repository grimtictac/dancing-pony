meta {
  name: Wrong currency
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/restaurants/{{restaurant}}/dishes
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Second breakfast",
    "description": "Priced in pounds by mistake.",
    "price": { "amount": 1200, "currency": "GBP" },
    "image": "https://example.com/second-breakfast.jpg"
  }
}

assert {
  res.status: eq 400
  res.body.detail: eq "price.currency must be ZAR"
}
