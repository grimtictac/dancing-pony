meta {
  name: Invalid rating
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/restaurants/{{restaurant}}/dishes/{{firstDishId}}/reviews/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{frodoToken}}
}

body:json {
  {
    "rating": 6
  }
}

assert {
  res.status: eq 400
  res.body.detail: contains "rating must be"
}
