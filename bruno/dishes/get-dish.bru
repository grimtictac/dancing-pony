meta {
  name: Get dish
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/restaurants/{{restaurant}}/dishes/{{firstDishId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.id: eq "{{firstDishId}}"
  res.body.name: eq "Seed Cake"
  res.body.price.amount: eq 8500
  res.body.price.currency: eq "ZAR"
}
