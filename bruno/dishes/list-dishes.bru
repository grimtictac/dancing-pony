meta {
  name: List dishes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/restaurants/{{restaurant}}/dishes
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].name: eq "Seed Cake"
}

vars:post-response {
  firstDishId: res.body[0].id
}

tests {
  test("every price is whole ZAR cents", function () {
    for (const d of res.getBody()) {
      expect(Number.isInteger(d.price.amount)).to.equal(true);
      expect(d.price.amount).to.be.above(0);
      expect(d.price.currency).to.equal("ZAR");
    }
  });
}
